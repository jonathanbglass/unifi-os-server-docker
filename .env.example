# Address UniFi devices use to reach this controller.
# Use the host LAN IP or a DNS name, not the container address.
UOS_SYSTEM_IP=192.0.2.10

TZ=UTC

# Private GHCR tag. There is no floating latest tag.
UOS_IMAGE=ghcr.io/jonathanbglass/unifi-os-server:5.1.42

# Last MongoDB 4.4 release. See the README before changing the major version.
MONGO_IMAGE=mongo:4.4.29

# Leave both empty unless you have already created a MongoDB user.
# The compose file does not publish MongoDB and does not enable auth.
MONGO_USER=
MONGO_PASS=
MONGO_TLS=false
MONGO_AUTH_SOURCE=admin

UOS_SHOW_JOURNAL=true

# Persistent directories. Back these up together. See the README.
DATA_DIR=./data/unifi
UNIFI_DIR=./data/var-lib-unifi
MONGODB_LIB_DIR=./data/var-lib-mongodb
RABBITMQ_SSL_DIR=./data/etc-rabbitmq-ssl
MONGO_DATA_DIR=./data/mongodb
